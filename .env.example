# FreshRSS: 启用 API，并使用个人资料中的 API 密码（不是网页登录密码）。
FRESHRSS_FEVER_URL=https://rss.example.com/api/fever.php
FRESHRSS_USER=your_username
FRESHRSS_API_PASS=your_api_password

# OpenAI 兼容接口，地址填写到 /v1，不要包含 /chat/completions。
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_api_key
LLM_MODEL=gpt-4o-mini

# SMTP 邮件服务。密码通常是邮箱服务商提供的授权码或应用专用密码。
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sender@example.com
SMTP_PASS=your_smtp_password
# 留空则使用 SMTP_USER；填写服务商允许的发件地址。
EMAIL_FROM=
# 多个收件人用英文逗号分隔，只填写邮箱地址，不带显示名称。
EMAIL_TO=recipient@example.com

# 465 使用 SMTP_SECURE=true；587 使用 SMTP_SECURE=false（强制 STARTTLS）。
# 未填写 SMTP_SECURE 时，根据端口自动选择。
# 仅影响邮件标题日期；GitHub Actions 执行时间由 workflow 的 cron 决定。
TIMEZONE=Asia/Hong_Kong
LOOKBACK_HOURS=24
MAX_ARTICLES=300
SUMMARY_LENGTH=250
# true: 邮件被全部收件人接受后，将本次扫描的全部文章标记为已读。
MARK_AS_READ=false
